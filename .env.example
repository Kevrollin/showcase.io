# ─── Frontend (bundled into the browser — public values only) ────────────────
# Supabase project URL and anon/publishable key (Project Settings → API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Canonical public URL of the app, without a trailing slash.
# Used for storefront links, QR codes, canonical tags and auth redirects.
# Leave empty in local development to use the current browser origin.
VITE_SITE_URL=
# Optional public contact address shown in the marketing footer and legal pages.
VITE_CONTACT_EMAIL=
# Google sign-in needs NO variable here. The Google client ID and secret are
# entered only in Supabase → Authentication → Sign In / Providers → Google.

# ─── Server-side (Vercel Function: api/share-preview.ts) ─────────────────────
# Only the public anon key is needed. NEVER put a service-role/secret key here
# or in any VITE_ variable.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Canonical site URL used in social-preview HTML (same as VITE_SITE_URL).
SITE_URL=

# ─── Optional: end-to-end tests against a real Supabase project ──────────────
# E2E_SUPABASE_URL=
# E2E_SUPABASE_ANON_KEY=
